#!/bin/sh

GREY='\033[90m'
GREEN='\033[32m'
RED='\033[31m'
RESET='\033[0m'

project_dir=${1:-.}
mode=$2
tester_dir=$(cd "$(dirname "$0")" && pwd)

usage()
{
	printf "Usage: make [a | b | c]\n"
	printf "	a: Basic tests\n"
	printf "	b: Bonus tests\n"
	printf "	c: Basic and bonus tests\n\n"
}

print_banner()
{
	printf '%s\n' "-----------------------------------------------------------------------"
	printf '%s\n' "####--####--#####-#---#-#####-#####-#####-####---###--#####--###--####-"
	printf '%s\n' "#---#-#---#---#---##--#---#---#-----#-----#---#-#---#---#---#---#-#---#"
	printf '%s\n' "####--####----#---#-#-#---#---####--####--####--#####---#---#---#-####-"
	printf '%s\n' "#-----#--#----#---#--##---#---#-----#-----#--#--#---#---#---#---#-#--#-"
	printf '%s\n' "#-----#---#-#####-#---#---#---#-----#####-#---#-#---#---#----###--#---#"
	printf '%s\n\n\n' "-----------------------------------------------------------------------"
}

check_norm()
{
	printf "Norminette...\n"
	if ! command -v norminette > /dev/null 2>&1; then
		printf "${GREY}norminette introuvable, verification ignoree\n\n${RESET}"
		return
	fi
	errors=$(norminette | grep --color=never "Error")
	if [ -n "$errors" ]; then
		printf "${GREY}"
		printf "%s\n" "$errors" | awk '{print $1, $2, $3, $4, $5, $6}' | tr ':' ' '
		printf "${RESET}\n"
	else
		printf "${GREEN}Correct\n\n${RESET}"
	fi
}

check_files()
{
	printf "Check Files...\n"
	files=$(find . -path ./.git -prune -o -type f \
		! -name "*.c" ! -name "*.h" \
		! -name "Makefile" ! -name "README.md" ! -name ".gitignore" \
		-print | tr '\n' ' ')
	if [ -n "$files" ]; then
		printf "\nForbidden files found\n${GREY}%s${RESET}\n\n" "$files"
	else
		printf "${GREEN}No Forbidden files\n\n${RESET}"
	fi
}

check_readme()
{
	readme="README.md"

	printf "Check README...\n"
	if [ ! -f "$readme" ]; then
		printf "${RED}README.md absent\n\n${RESET}"
		return 1
	fi

	ok=1

	# Premiere ligne en italique : *texte* ou _texte_
	if ! head -n 1 "$readme" | tr -d '\r' \
		| grep -qE '^(\*[^*].*[^*]\*|_[^_].*[^_]_)[[:space:]]*$'; then
		printf "${RED}La premiere ligne n'est pas en italique\n${RESET}"
		ok=0
	fi

	# Chapitres obligatoires (titres markdown : #, ##, ###...)
	for section in "Description" "Instructions" "Resources"; do
		if ! grep -qiE "^#+[[:space:]]*${section}" "$readme"; then
			printf "${RED}Chapitre manquant : ${section}\n${RESET}"
			ok=0
		fi
	done

	if [ "$ok" -eq 1 ]; then
		printf "${GREEN}Readme correct\n\n${RESET}"
		return 0
	fi
	printf "\n"
	return 1
}

compile_project()
{
	printf "Compile...\n\n"
	if [ "$mode" -ge 1 ]; then
		rule="bonus"
	else
		rule=""
	fi
	if ! make $rule -s; then
		printf "${RED}Can't compile, because error\n${RESET}"
		return 1
	fi
	printf "\n"
}

run_tests()
{
	mkdir -p ft_printf
	cp "$project_dir"/libftprintf.a ./ft_printf/ || return 1
	cc -Wno-format ./test/main.c ./test/basic.c ./test/bonus.c \
		./ft_printf/libftprintf.a -g3 || return 1
	./a.out "$mode"
}

clean_tester()
{
	rm -rf "$tester_dir"/ft_printf "$tester_dir"/a.out "$tester_dir"/a.out.dSYM
}

# Main

if [ ! -d "$project_dir" ] || [ -z "$mode" ]; then
	usage
	exit 1
fi
project_dir=$(cd "$project_dir" && pwd)

print_banner
clean_tester

cd "$project_dir" || exit 1
check_norm
check_files
check_readme
if ! compile_project; then
	make fclean -s
	exit 1
fi

cd "$tester_dir" || exit 1
run_tests
clean_tester

cd "$project_dir" || exit 1
make fclean -s
